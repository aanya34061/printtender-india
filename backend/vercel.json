{
  "version": 2,
  "builds": [{ "src": "index.py", "use": "@vercel/python" }],
  "routes": [{ "src": "/(.*)", "dest": "index.py" }],
  "crons": [
    {
      "path": "/api/fetch/cron",
      "schedule": "0 2 * * *"
    },
    {
      "path": "/api/fetch/mail-cron",
      "schedule": "30 2 * * *"
    }
  ]
}
